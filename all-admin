<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ff6a00">
    <title>অ্যাডমিন ব্যবস্থাপনা - SERA PRODUCT Owner Panel</title>
    <link rel="icon" href="https://seraproduct.com/photo/logo.png">
    <link rel="stylesheet" href="all-admin.css">
</head>
<body>

    <!-- ইনিশিয়ালাইজেশন এবং সিকিউরিটি লোডিং স্ক্রিন -->
    <div id="auth-loader" class="auth-loader">
        <div class="loader-content">
            <svg class="spinner-svg" viewBox="0 0 50 50">
                <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
            </svg>
            <p>ওনার অ্যাক্সেস যাচাই করা হচ্ছে...</p>
        </div>
    </div>

    <!-- মূল অ্যাপ্লিকেশন কন্টেইনার -->
    <div id="app-container" class="app-container hidden">
        
        <!-- হেডার সেকশন -->
        <header class="app-header">
            <div class="header-left">
                <img src="https://seraproduct.com/photo/logo.png" alt="Sera Product Logo" class="brand-logo" onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'120\' height=\'40\'><text x=\'0\' y=\'25\' font-size=\'20\' fill=\'%23FF6A00\' font-weight=\'bold\'>SERA PRODUCT</text></svg>';">
                <div class="header-title-wrap">
                    <h1>অ্যাডমিন ব্যবস্থাপনা</h1>
                    <span class="owner-badge">OWNER</span>
                </div>
            </div>
            <div class="header-right">
                <span id="owner-email-display" class="owner-email">owner@seraproduct.com</span>
                <button id="logout-btn" class="logout-btn" title="লগআউট">
                    <svg viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                    <span>লগআউট</span>
                </button>
            </div>
        </header>

        <!-- মূল কন্টেন্ট এরিয়া -->
        <main class="main-content">
            
            <!-- পেজ সাবটাইটেল এবং অ্যাকশন বার -->
            <div class="content-topbar">
                <div class="subtitle-wrap">
                    <h2>অ্যাডমিন অ্যাকাউন্ট পরিচালনা করুন</h2>
                    <p>সিস্টেমের সমস্ত অ্যাডমিনদের তালিকা এবং তাদের স্ট্যাটাস নিয়ন্ত্রণ করুন</p>
                </div>
                <button id="open-create-modal-btn" class="primary-btn">
                    <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                    <span>অ্যাডমিন তৈরি করুন</span>
                </button>
            </div>

            <!-- পরিসংখ্যান এবং সার্চ বার -->
            <div class="dashboard-controls">
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">মোট অ্যাডমিন (লোডকৃত)</span>
                        <span id="total-admin-count" class="stat-value">০</span>
                    </div>
                </div>

                <div class="search-box-wrap">
                    <span class="search-icon">
                        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    </span>
                    <input type="text" id="search-input" placeholder="নাম, ইমেইল অথবা UID দিয়ে খুঁজুন">
                </div>
            </div>

            <!-- অ্যাডমিন টেবিল/লিস্ট সেকশন -->
            <div class="table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>নাম</th>
                            <th>ইমেইল</th>
                            <th>ইউআইডি (UID)</th>
                            <th>অবস্থা</th>
                            <th>কার্যক্রম</th>
                        </tr>
                    </thead>
                    <tbody id="admin-table-body">
                        <!-- ডাইনামিক ডেটা এখানে লোড হবে -->
                    </tbody>
                </table>

                <!-- এম্পটি স্টেট -->
                <div id="empty-state" class="empty-state hidden">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                    <p>কোনো অ্যাডমিন পাওয়া যায়নি</p>
                </div>
            </div>

            <!-- লোড মোর (আরও দেখুন) বাটন -->
            <div class="load-more-wrap">
                <button id="load-more-btn" class="secondary-btn hidden">
                    <span id="load-more-text">আরও দেখুন</span>
                    <svg id="load-more-spinner" class="btn-spinner hidden" viewBox="0 0 50 50">
                        <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                    </svg>
                </button>
            </div>

        </main>
    </div>

    <!-- মোডাল: অ্যাডমিন তৈরি করুন -->
    <div id="create-modal" class="modal-overlay hidden">
        <div class="modal-card">
            <div class="modal-header">
                <h3>নতুন অ্যাডমিন তৈরি করুন</h3>
                <button class="close-modal-btn" data-modal="create-modal">
                    <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                </button>
            </div>
            <form id="create-admin-form">
                <div class="form-group">
                    <label for="create-uid">Firebase UID</label>
                    <input type="text" id="create-uid" required placeholder="Firebase UID লিখুন">
                </div>
                <div class="form-group">
                    <label for="create-name">নাম</label>
                    <input type="text" id="create-name" required placeholder="অ্যাডমিনের নাম লিখুন">
                </div>
                <div class="form-group">
                    <label for="create-email">ইমেইল</label>
                    <input type="email" id="create-email" required placeholder="অ্যাডমিনের ইমেইল লিখুন">
                </div>
                <div class="form-group">
                    <label>সক্রিয় অবস্থা</label>
                    <div class="status-radio-group">
                        <label><input type="radio" name="create-active" value="true" checked> সক্রিয়</label>
                        <label><input type="radio" name="create-active" value="false"> নিষ্ক্রিয়</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn close-modal-btn" data-modal="create-modal">বাতিল</button>
                    <button type="submit" id="create-submit-btn" class="primary-btn">সংরক্ষণ করুন</button>
                </div>
            </form>
        </div>
    </div>

    <!-- মোডাল: অ্যাডমিন সম্পাদনা (Edit) -->
    <div id="edit-modal" class="modal-overlay hidden">
        <div class="modal-card">
            <div class="modal-header">
                <h3>অ্যাডমিন তথ্য পরিবর্তন করুন</h3>
                <button class="close-modal-btn" data-modal="edit-modal">
                    <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                </button>
            </div>
            <form id="edit-admin-form">
                <input type="hidden" id="edit-uid">
                <div class="form-group">
                    <label>Firebase UID (অপরিবর্তনযোগ্য)</label>
                    <input type="text" id="edit-uid-display" disabled class="disabled-input">
                </div>
                <div class="form-group">
                    <label for="edit-name">নাম</label>
                    <input type="text" id="edit-name" required placeholder="অ্যাডমিনের নাম লিখুন">
                </div>
                <div class="form-group">
                    <label for="edit-email">ইমেইল</label>
                    <input type="email" id="edit-email" required placeholder="অ্যাডমিনের ইমেইল লিখুন">
                </div>
                <div class="form-group">
                    <label for="edit-active">সক্রিয় অবস্থা</label>
                    <select id="edit-active" class="select-box">
                        <option value="true">সক্রিয়</option>
                        <option value="false">নিষ্ক্রিয়</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn close-modal-btn" data-modal="edit-modal">বাতিল</button>
                    <button type="submit" id="edit-submit-btn" class="primary-btn">আপডেট করুন</button>
                </div>
            </form>
        </div>
    </div>

    <!-- মোডাল: ডিলিট কনফার্মেশন -->
    <div id="delete-modal" class="modal-overlay hidden">
        <div class="modal-card confirm-card">
            <div class="modal-header">
                <h3>অ্যাডমিন মুছে ফেলবেন?</h3>
            </div>
            <p class="confirm-text">এই অ্যাডমিনের Firestore ডকুমেন্ট স্থায়ীভাবে মুছে যাবে। আপনি কি নিশ্চিত?</p>
            <div class="modal-footer">
                <button type="button" class="cancel-btn close-modal-btn" data-modal="delete-modal">বাতিল</button>
                <button type="button" id="confirm-delete-btn" class="danger-btn">মুছে ফেলুন</button>
            </div>
        </div>
    </div>

    <!-- টোস্ট নোটিফিকেশন কন্টেইনার -->
    <div id="toast-container" class="toast-container"></div>

    <!-- মূল অ্যাপ্লিকেশন স্ক্রিপ্ট -->
    <script type="module" src="all-admin.js"></script>
</body>
</html>
